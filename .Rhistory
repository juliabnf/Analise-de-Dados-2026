group_by(Year, PlotID,WinterCrop, Nrate, Block) %>% # Replace with a variable to group by (e.g., Plot, Treatment)
summarize(
recoveryBIO = sum(recoveryBIO, na.rm = TRUE),
recoveryGrain = sum(recoveryGrain, na.rm = TRUE)
)%>%
mutate(pct_recovery=recoveryBIO+recoveryGrain,
Sampling = case_when(Year == 2023 ~ "Post-termination 2023",
Year == 2024 ~ "Post-termination 2024"))
m7<-lme(pct_recovery~ WinterCrop*Nrate,
random= ~1|Block/WinterCrop,
data = data3%>%filter( Year==2023,
WinterCrop!="Clover"))
anova(m7)
cld(emmeans(m7, ~WinterCrop), Letters=letters, reversed = T, alpha=0.5) #marginally sig.
cld(emmeans(m7, ~Nrate), Letters=letters, reversed = T, alpha=0.5) #marginally sig.
m8<-lme(pct_recovery~ WinterCrop*Nrate,
random= ~1|Block/WinterCrop,
data = data3%>%filter( Year==2024))
anova(m8)
cld(emmeans(m8, ~WinterCrop), Letters=letters, reversed = T, alpha=0.5) #marginally sig.
cld(emmeans(m8, ~Nrate), Letters=letters, reversed = T, alpha=0.5) #marginally sig.
WCplant<-read.xlsx("CHICK22-23_Winter crops_v07.xlsx",
sheet="Plant")%>%
filter(N15=="Y")%>%
filter(Sampling %in% c("Post-termination 2023", "Post-termination 2024"))
WCplant$WinterCrop[WCplant$WinterCrop=="CDC Leader"]<-"Chickpea"
WCplant$PlotID<-as.factor(WCplant$PlotID)
WCplant$Block<-as.factor(WCplant$Block)
WCplant$WinterCrop<-factor(WCplant$WinterCrop, levels = c("Fallow", "Rye", "Clover", "Chickpea" ))
WCplant$Nrate<-as.factor(WCplant$Nrate)
Ncredits <- merge(data3[, c("PlotID", "Sampling", "pct_recovery")],
WCplant[, c("PlotID", "Sampling",
names(WCplant)[which(names(WCplant) == "Order"):which(names(WCplant) == "Biomass_N")])],
by = c("PlotID", "Sampling"))
Ncredits2<-Ncredits%>%
mutate(Ncredits_kgha= Biomass_N * pct_recovery/100)
m9<-lme(Ncredits_kgha~ WinterCrop*Nrate,
random= ~1|Block/WinterCrop,
data = Ncredits2%>%filter( Sampling=="Post-termination 2023",
WinterCrop!="Clover"))
anova(m9)
cld(emmeans(m9, ~WinterCrop|Nrate), Letters=letters, reversed = T, alpha=0.5) #marginally sig.
cld(emmeans(m7, ~Nrate), Letters=letters, reversed = T, alpha=0.5) #marginally sig.
m10<-lme(Ncredits_kgha~ WinterCrop*Nrate,
random= ~1|Block/WinterCrop,
data = Ncredits2%>%filter( Sampling=="Post-termination 2024"))
anova(m10)
cld(emmeans(m10, ~WinterCrop), Letters=letters, reversed = T, alpha=0.5) #marginally sig.
cld(emmeans(m10, ~Nrate), Letters=letters, reversed = T, alpha=0.5) #marginally sig.
Ncreditstable<-Ncredits2%>%filter(WinterCrop!="Fallow")%>%
group_by(Sampling,WinterCrop,Nrate) %>%
summarise(n = n(),
Ncredits = mean(Ncredits_kgha),
SD = sd(Ncredits_kgha)) %>%
mutate(SE = SD / sqrt(as.numeric(n)))%>%
mutate(y_limit = case_when(
Sampling == "Post-termination 2023"  ~ 30,
Sampling == "Post-termination 2024"~ 30  # Default limit for other facets
))
Ncreditstable$Nrate<- factor(Ncreditstable$Nrate, levels =
c("Low", "High"))
View(Ncreditstable)
ggplot(Ncreditstable %>%
mutate(Ncredits = ifelse(WinterCrop == "Clover" & Sampling == "Post-termination 2023", NA, Ncredits)) %>%
mutate(SE = ifelse(WinterCrop == "Clover" & Sampling == "Post-termination 2023", NA, SE)),
aes(x = WinterCrop, y = Ncredits, fill = WinterCrop, pattern = Nrate)) +
geom_bar_pattern(stat = "identity", position = position_dodge(width = 0.8), color = "black",
width = 0.7,
pattern_fill = "black",
pattern_angle = 45,
pattern_density = 0.05,
pattern_spacing = 0.025,
pattern_key_scale_factor = 0.8) +
geom_errorbar(aes(ymin = Ncredits - SE, ymax = Ncredits + SE),
position = position_dodge(width = 0.8), width = 0.25, linewidth = 0.7) +
scale_pattern_manual(values = c("stripe", "none", "circle")) +
scale_fill_manual(values = c("#F3A813", "#2795EC" ,"#175382")) +
labs(y = expression("N credits (kg " * ha^{-1} * ")"), x = NULL,
pattern = "Pool", fill = "Winter Crop", title = NULL) +
facet_wrap(Sampling ~ ., nrow = 1,
labeller = labeller(Sampling = c("Post-termination 2023" = "2023",
"Post-termination 2024" = "2024"))) +
theme_bw(base_size = 18) +
geom_blank(aes(y = y_limit)) +
scale_y_continuous( expand = c(0, 0)) +
guides(fill = guide_legend(override.aes = list(pattern = "none", color = "black")),
pattern = guide_legend(override.aes = list(fill = "white", color = "black"))) +
theme(axis.text.x = element_text(angle = 45, hjust = 1, vjust = 1),
plot.title = element_text(hjust = 0.5, vjust = 1),
strip.background = element_blank(),
strip.text = element_text(size=17))
